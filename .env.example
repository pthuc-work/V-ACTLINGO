# ==============================================================================
# V-ACT HUB: Environment Configuration
# ==============================================================================
# Copy this file to .env.local to configure your local Supabase instance
# If left empty or unset, the application automatically runs in Offline / Local mode (IndexedDB)

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Public API Key (e.g., eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
VITE_SUPABASE_ANON_KEY=
